# Neon PostgreSQL connection string
DATABASE_URL=

# Optional: separate test DB for automated tests
# TEST_DATABASE_URL=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Session signing secret (use a long random value, 64+ chars recommended)
SESSION_SECRET=

# Vercel Cron authentication (for auto-backup)
# Generate with: openssl rand -base64 32
# CRON_SECRET=

# db:seed — admin user (required for npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Compatibility aliases also supported:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Optional: extra users as JSON array (email is the login username)
# SEED_USERS=[{"email":"staff1","password":"pass123","name":"Staff One","role":"staff"},{"email":"test","password":"test1234","name":"Test User"}]
# Optional: company contact email in settings; defaults to SEED_ADMIN_EMAIL
# SEED_COMPANY_EMAIL=
# Optional: partner/shareholder config as JSON array (sorted alphabetically → slots A/B/C)
# SEED_PARTNERS=[{"name":"Author","email":"author@bobsolar.com","ownershipPercent":33.34},{"name":"Arkar","email":"arkar@bobsolar.com","ownershipPercent":33.33},{"name":"Yenyeinaung","email":"yenyeinaung@bobsolar.com","ownershipPercent":33.33}]
# ALLOW_PROD_SEED=1
# SEED_RESET_ALERTS=1
