# Neon PostgreSQL connection string
DATABASE_URL=

# Optional: separate test DB for automated tests
# TEST_DATABASE_URL=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Session signing secret (use a long random value, 64+ chars recommended)
SESSION_SECRET=

# Vercel Cron authentication (for auto-backup)
# Generate with: openssl rand -base64 32
# CRON_SECRET=

# db:seed — admin user (required for npm run db:seed)
# This is the bootstrap account. It can be deleted from Settings → User
# Management once the 3 partners have been created in-app.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Compatibility aliases also supported:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Optional: company contact email in settings; defaults to SEED_ADMIN_EMAIL
# SEED_COMPANY_EMAIL=

# Partners are NOT seeded via env vars. Add the 3 partners in-app via
# Settings → Partners (name, email, password, ownership %).

# ALLOW_PROD_SEED=1
# SEED_RESET_ALERTS=1

# Google Gemini API Key for ChatBot
GOOGLE_GENERATIVE_AI_API_KEY=
