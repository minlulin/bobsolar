# Neon PostgreSQL connection string
DATABASE_URL=

# Optional: separate test DB for automated tests
# TEST_DATABASE_URL=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Session signing secret (use a long random value, 64+ chars recommended)
SESSION_SECRET=

# db:seed — admin user (required for npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Compatibility aliases also supported:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Optional: company contact email in settings; defaults to SEED_ADMIN_EMAIL
# SEED_COMPANY_EMAIL=
# ALLOW_PROD_SEED=1
# SEED_RESET_ALERTS=1
