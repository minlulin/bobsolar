{
  "name": "bobsolar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbo": "next build --turbo",
    "start": "next start",
    "lint": "pnpm biome:check && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:fix": "pnpm biome:fix",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.sw.json --noEmit",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx src/lib/db/baseline-migrations.ts",
    "db:test:ping": "tsx scripts/db-test-ping.ts",
    "db:migrate:test": "pnpm exec drizzle-kit push --config drizzle.test.config.ts --force",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts --confirm=RESET --mode=full",
    "db:factory-reset": "tsx scripts/db-reset.ts --confirm=RESET --mode=factory",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:handover-reset": "tsx scripts/db-handover-reset.ts --confirm=HANDOVER_RESET",
    "db:handover-verify": "tsx scripts/db-handover-verify.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:code": "vitest run --exclude src/__tests__/db-ugly-path.test.ts --exclude src/__tests__/db-workflow-master.test.ts",
    "test:db": "pnpm db:test:ping && pnpm db:migrate:test && vitest run --pool=threads --maxWorkers=1 --no-file-parallelism src/__tests__/db-ugly-path.test.ts src/__tests__/db-workflow-master.test.ts",
    "green:code": "pnpm typecheck && pnpm biome:check && pnpm test:code",
    "green:db": "pnpm test:db",
    "green": "pnpm green:code && pnpm green:db && pnpm build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.77.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.42",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.1.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "lefthook": "^2.1.9",
    "pg": "^8.21.0",
    "serwist": "^9.5.11",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.1.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ]
}
